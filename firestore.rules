rules_version = '2';
// ============================================================================
// Règles de sécurité Luisart (Firestore)
// À publier dans : console Firebase › Firestore Database › Règles › Publier.
//
// Principes
//  • Tout ce qui n'est pas prévu ici est refusé.
//  • Chaque visiteur a un compte (anonyme au départ, Google ensuite) : il ne
//    peut créer ou modifier que SES propres documents.
//  • L'administrateur (amourdvine@gmail.com, e-mail vérifié) peut tout gérer.
//  • Les rôles d'équipe (assoc, modo, support) reprennent exactement les
//    permissions de l'application, seulement si les rôles sont activés.
//  • Messages privés, demandes, tickets, paiements, commandes, téléphones :
//    visibles uniquement par les personnes concernées.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- outils
    function connecte() { return request.auth != null; }
    function admin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() in ['amourdvine@gmail.com'];
    }
    // « soi(x) » : x est la personne connectée (ou l'administrateur, dont
    // l'identifiant dans l'application diffère de son compte).
    function soi(x) { return connecte() && (x == request.auth.uid || admin()); }
    function chemin(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function monRole() { return get(chemin('artists', request.auth.uid)).data.get('adm', ''); }
    function rolesActifs() {
      return exists(chemin('cfg', 'site')) && get(chemin('cfg', 'site')).data.get('roles', false) == true;
    }
    // Permissions identiques à l'application (PERM)
    function peut(p) {
      return admin() || (connecte() && rolesActifs() && exists(chemin('artists', request.auth.uid)) && (
           (monRole() == 'assoc'   && p in ['dash', 'req', 'tk', 'rep', 'val', 'mem'])
        || (monRole() == 'modo'    && p in ['dash', 'rep', 'mem', 'val'])
        || (monRole() == 'support' && p in ['dash', 'req', 'tk'])));
    }
    function equipe() { return peut('dash'); }
    function modifies() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function seulement(l) { return modifies().hasOnly(l); }
    function aucun(l) { return !modifies().hasAny(l); }
    function inchange(k) { return request.resource.data.get(k, null) == resource.data.get(k, null); }
    function nouveau() { return request.resource.data; }
    function texteCourt(k, n) { return !(k in nouveau()) || (nouveau()[k] is string && nouveau()[k].size() <= n); }
    function membreValide() {
      return exists(chemin('artists', request.auth.uid))
        && get(chemin('artists', request.auth.uid)).data.get('mem', '') == 'ok';
    }
    // Compte Pro en cours de validité (création et modification des certificats)
    function comptePro() {
      return exists(chemin('artists', request.auth.uid))
        && get(chemin('artists', request.auth.uid)).data.get('pro', false) == true
        && (get(chemin('artists', request.auth.uid)).data.get('proUntil', 0) == 0
            || get(chemin('artists', request.auth.uid)).data.get('proUntil', 0) > request.time.toMillis());
    }
    // Membre confirmé (ou administrateur) : requis pour publier et écrire aux autres
    function membre() { return admin() || membreValide(); }
    // Publication programmée (champ « at ») : réservée aux comptes Pro
    function programmeOk() {
      return nouveau().get('at', 0) == 0 || admin() || comptePro()
        || (resource != null && nouveau().get('at', 0) == resource.data.get('at', 0));
    }
    function adhesionAuto() {
      return exists(chemin('cfg', 'site')) && get(chemin('cfg', 'site')).data.get('memm', '') == 'auto';
    }

    // ------------------------------------------------- réglages et actualités
    match /cfg/{id}    { allow read: if true; allow write: if admin(); }
    match /news/{id}   { allow read: if true; allow write: if admin(); }
    match /veille/{id} { allow read, write: if admin(); }

    // ---------------------------------------------------------------- profils
    // Champs réservés : statut Pro, certification, rôle d'équipe, sanctions.
    // Le téléphone et l'e-mail ne vont jamais dans le profil public (voir « priv »).
    match /artists/{id} {
      allow read: if true;
      allow create: if admin() || (connecte() && id == request.auth.uid
        && nouveau().get('adm', '') == ''
        && nouveau().get('pro', false) != true
        && nouveau().get('cert', false) != true
        && nouveau().get('proUntil', 0) == 0
        && nouveau().get('demo', false) != true
        && nouveau().get('susp', 0) == 0
        && nouveau().get('warn', 0) == 0
        && !nouveau().keys().hasAny(['tel', 'mail'])
        && (nouveau().get('mem', '') != 'ok' || adhesionAuto())
        && texteCourt('name', 120) && texteCourt('bio', 5000));
      allow update: if admin()
        || (connecte() && id == request.auth.uid
            && aucun(['adm', 'pro', 'cert', 'proUntil', 'demo', 'susp', 'warn', 'wlc', 'badge'])
            && !(modifies().hasAny(['tel', 'mail']) && nouveau().keys().hasAny(['tel', 'mail']))
            && (nouveau().get('mem', '') != 'ok' || resource.data.get('mem', '') == 'ok' || adhesionAuto())
            && texteCourt('name', 120) && texteCourt('bio', 5000))
        || (peut('mem') && seulement(['mem', 'memwhy', 'mdts', 'warn', 'susp']))
        || (peut('rep') && seulement(['warn', 'susp']))
        || ((peut('req') || peut('val')) && seulement(['cert']));
      allow delete: if admin();
    }
    // Coordonnées privées (téléphone, e-mail, WhatsApp de candidature)
    match /priv/{id} {
      allow read: if soi(id) || peut('mem');
      allow create, update: if soi(id) && nouveau().uid == id
        && texteCourt('tel', 20) && texteCourt('mail', 120) && texteCourt('wa', 20);
      allow delete: if admin();
    }
    // Données personnelles (abonnements, dossiers de candidature…)
    match /data/users/{uid}/{rest=**} { allow read, write: if soi(uid); }

    // ------------------------------------------------------- messages privés
    match /dm/{id} {
      allow read: if soi(resource.data.from) || soi(resource.data.to);
      // Un membre confirmé écrit librement (l'application applique la demande de discussion).
      // Un visiteur n'envoie qu'UN premier message, créé avec sa demande ; la suite
      // exige que le destinataire ait accepté (ou qu'il suive / ait écrit au visiteur).
      allow create: if soi(nouveau().from) && nouveau().to is string
        && nouveau().to != nouveau().from && texteCourt('text', 5000)
        && (membre() || discussionOuverte(nouveau().from, nouveau().to));
      // L'expéditeur modifie ou efface son message ; le destinataire peut seulement
      // réagir ou répondre à une offre, sans en changer le montant ni l'œuvre.
      allow update: if inchange('from') && inchange('to') && (
           (soi(resource.data.from)
             && seulement(['text', 'img', 'au', 'stk', 'wk', 'loc', 'ex', 'rp', 're', 'of', 'del'])
             && (offreLibre() || offreIntacte()))
        || (soi(resource.data.to) && seulement(['re', 'of']) && offreIntacte()));
      allow delete: if soi(resource.data.from);
    }
    function discussionOuverte(de, a) {
      return exists(chemin('fol', a + '_' + de))
        || (exists(chemin('dmok', a + '_' + de)) && get(chemin('dmok', a + '_' + de)).data.st == 'ok')
        || (exists(chemin('dmok', de + '_' + a)) && get(chemin('dmok', de + '_' + a)).data.st in ['att', 'ok'])
        || (!exists(chemin('dmok', a + '_' + de)) && getAfter(chemin('dmok', a + '_' + de)).data.get('st', '') == 'att');
    }
    function inscrit(c) {
      return exists(chemin('enroll', c + '_' + request.auth.uid))
        && get(chemin('enroll', c + '_' + request.auth.uid)).data.st == 'ok';
    }
    function offreLibre() { return !(resource.data.get('of', null) is map) || resource.data.of.get('st', '') == 'att'; }
    function offreIntacte() {
      return !(resource.data.get('of', null) is map)
        || (nouveau().get('of', null) is map
            && nouveau().of.get('amt', null) == resource.data.of.get('amt', null)
            && nouveau().of.get('wid', null) == resource.data.of.get('wid', null));
    }
    // Accusés de lecture : identifiant = lecteur_interlocuteur
    match /dmr/{id} {
      allow read: if soi(resource.data.a) || soi(resource.data.b);
      allow create, update: if soi(nouveau().a) && id == nouveau().a + '_' + nouveau().b;
    }
    // Demandes de message : identifiant = destinataire_expéditeur
    match /dmok/{id} {
      allow read: if soi(resource.data.from) || soi(resource.data.to);
      allow create: if soi(nouveau().from) && nouveau().st == 'att'
        && id == nouveau().to + '_' + nouveau().from;
      allow update: if soi(resource.data.to) && nouveau().st in ['ok', 'no'] && seulement(['st', 'dts']);
      allow delete: if admin();
    }
    // Blocages : identifiant = bloqueur_bloqué
    match /blk/{id} {
      allow read: if soi(resource.data.from) || soi(resource.data.to);
      allow create: if soi(nouveau().from) && id == nouveau().from + '_' + nouveau().to;
      allow delete: if soi(resource.data.from);
    }

    // ------------------------------------------------- abonnements et présence
    match /fol/{id} {
      allow read: if true;
      allow create: if soi(nouveau().from) && id == nouveau().from + '_' + nouveau().to;
      allow delete: if soi(resource.data.from);
    }
    match /pres/{id} {
      allow read: if connecte();
      allow write: if soi(id);
    }
    match /pv/{id} {
      allow read: if soi(resource.data.a) || soi(resource.data.v);
      allow create, update: if soi(nouveau().v) && id.matches('.*_' + nouveau().v);
    }
    match /pvp/{id} {
      allow read: if soi(resource.data.a) || soi(resource.data.v);
      allow create, update: if soi(nouveau().v) && id.matches('.*_' + nouveau().v);
    }

    // ------------------------------------------ contenus publiés par les membres
    // L'auteur crée et gère les siens ; l'équipe modère (masquer, valider, supprimer).
    match /works/{id} {
      allow read: if true;
      allow create: if soi(nouveau().aid) && membre() && programmeOk() && texteCourt('title', 200) && texteCourt('desc', 6000);
      allow update: if (soi(resource.data.aid) && inchange('aid') && aucun(['hid', 'pend']) && programmeOk()
                        && texteCourt('title', 200) && texteCourt('desc', 6000))
        || (peut('val') && seulement(['hid', 'pend']));
      allow delete: if soi(resource.data.aid) || peut('rep');
    }
    match /wimg/{id} {
      allow read: if true;
      // Photos supplémentaires : uniquement sur ses propres œuvres (sinon n'importe qui pourrait
      // glisser une image dans la fiche d'un autre artiste).
      allow create: if soi(nouveau().aid) && membre() && nouveau().wid is string
        && exists(chemin('works', nouveau().wid)) && get(chemin('works', nouveau().wid)).data.aid == nouveau().aid;
      allow update: if soi(resource.data.aid) && inchange('aid') && inchange('wid');
      allow delete: if soi(resource.data.aid) || peut('rep');
    }
    match /posts/{id} {
      allow read: if true;
      allow create: if soi(nouveau().aid) && membre() && programmeOk() && texteCourt('text', 5000);
      allow update: if soi(resource.data.aid) && inchange('aid') && aucun(['hid']) && programmeOk() && texteCourt('text', 5000);
      allow delete: if soi(resource.data.aid) || peut('rep');
    }
    match /stat/{id} {
      allow read: if true;
      allow create: if soi(nouveau().aid) && membre() && texteCourt('text', 2000);
      allow update: if soi(resource.data.aid) && inchange('aid') && texteCourt('text', 2000);
      allow delete: if soi(resource.data.aid) || peut('rep');
    }
    match /sv/{id} {
      allow read: if soi(resource.data.a) || soi(resource.data.v);
      allow create: if soi(nouveau().v) && id == nouveau().s + '_' + nouveau().v;
    }
    match /svl/{id} {
      allow read: if true;
      allow create: if soi(nouveau().v) && id == nouveau().s + '_' + nouveau().v;
      allow delete: if soi(resource.data.v);
    }
    // Annonces soumises à validation : un non-membre publie « en attente »
    match /places/{id} {
      allow read: if true;
      allow create: if soi(nouveau().aid) && (nouveau().pend == true || membreValide() || peut('val'));
      allow update: if (soi(resource.data.aid) && inchange('aid') && aucun(['pend', 'hid'])) || peut('val');
      allow delete: if soi(resource.data.aid) || peut('val');
    }
    match /mat/{id} {
      allow read: if true;
      allow create: if soi(nouveau().aid) && (nouveau().pend == true || membreValide() || peut('val'));
      allow update: if (soi(resource.data.aid) && inchange('aid') && aucun(['pend', 'hid'])) || peut('val');
      allow delete: if soi(resource.data.aid) || peut('val');
    }
    match /offers/{id} {
      allow read: if true;
      allow create: if soi(nouveau().aid) && (nouveau().pend == true || membreValide() || peut('val'));
      allow update: if (soi(resource.data.aid) && inchange('aid') && aucun(['pend', 'hid'])) || peut('val');
      allow delete: if soi(resource.data.aid) || peut('val');
    }
    // Formations (comptes Pro) : la fiche est publique, le contenu des chapitres
    // n'est lisible que par le formateur, les inscrits acceptés, ou si le chapitre est en aperçu gratuit
    match /courses/{id} {
      allow read: if true;
      allow create: if soi(nouveau().aid) && (admin() || comptePro())
        && texteCourt('title', 150) && texteCourt('desc', 8000) && texteCourt('cover', 950000)
        && !nouveau().keys().hasAny(['hid', 'pend']);
      allow update: if (soi(resource.data.aid) && inchange('aid') && aucun(['hid', 'pend']) && (admin() || comptePro())
                        && texteCourt('title', 150) && texteCourt('desc', 8000) && texteCourt('cover', 950000))
                    || (peut('val') && seulement(['hid', 'pend']));
      allow delete: if soi(resource.data.aid) || peut('val');
      match /ch/{c} {
        allow read: if resource.data.get('free', false) == true || admin()
          || (exists(chemin('courses', id)) && soi(get(chemin('courses', id)).data.aid))
          || inscrit(id);
        allow write: if admin()
          || (exists(chemin('courses', id)) && get(chemin('courses', id)).data.aid == request.auth.uid && comptePro());
      }
    }
    // Inscriptions : visibles par l'élève et le formateur ; gratuite = acceptée d'office,
    // payante = en attente de validation par le formateur
    match /enroll/{e} {
      allow read: if admin() || soi(resource.data.uid) || soi(resource.data.aid);
      allow create: if soi(nouveau().uid) && nouveau().c is string && e == nouveau().c + '_' + nouveau().uid
        && exists(chemin('courses', nouveau().c))
        && nouveau().aid == get(chemin('courses', nouveau().c)).data.aid
        && nouveau().aid != nouveau().uid
        && (nouveau().st == 'att'
            || (nouveau().st == 'ok' && get(chemin('courses', nouveau().c)).data.get('price', 0) == 0));
      allow update: if (soi(resource.data.uid) && seulement(['prog', 'last']))
        || ((soi(resource.data.aid) || admin()) && seulement(['st', 'dts']) && nouveau().st in ['ok', 'no', 'att']);
      allow delete: if soi(resource.data.uid) || soi(resource.data.aid) || admin();
    }
    // Avis sur les formations : seulement par les élèves inscrits et acceptés
    match /cav/{r} {
      allow read: if true;
      allow create, update: if soi(nouveau().uid) && nouveau().c is string && r == nouveau().c + '_' + nouveau().uid
        && inscrit(nouveau().c) && nouveau().r is int && nouveau().r >= 1 && nouveau().r <= 5 && texteCourt('t', 1000);
      allow delete: if soi(resource.data.uid) || peut('val');
    }
    // Galeries 3D personnelles : une salle par artiste (à son identifiant), réservée aux comptes Pro.
    // Lecture publique : la salle ne contient qu'un nom, une ambiance et une liste d'œuvres déjà publiques.
    // L'équipe ne peut que masquer une salle (hid) ; son propriétaire ne peut pas lever ce masquage.
    function salleValide() {
      return nouveau().keys().hasOnly(['aid', 'name', 'intro', 'style', 'wall', 'works', 'pub', 'ts', 'up', 'hid'])
        && nouveau().name is string && nouveau().name.size() >= 2 && nouveau().name.size() <= 60
        && texteCourt('intro', 300) && texteCourt('wall', 7)
        && nouveau().style in ['clair', 'bois', 'terre', 'nuit']
        && nouveau().works is list && nouveau().works.size() <= 30
        && nouveau().pub is bool;
    }
    match /rooms/{id} {
      allow read: if true;
      allow create: if soi(id) && nouveau().aid == id && (admin() || (comptePro() && membre()))
        && salleValide() && !nouveau().keys().hasAny(['hid']);
      allow update: if (soi(id) && inchange('aid') && aucun(['hid']) && (admin() || (comptePro() && membre())) && salleValide())
                    || (peut('val') && seulement(['hid']) && nouveau().hid is bool);
      allow delete: if soi(id) || peut('val');
    }
    // Certificats d'authenticité : vérifiables par tous ; seule l'équipe révoque
    match /certs/{id} {
      allow read: if true;
      allow create: if admin() || (soi(nouveau().aid) && comptePro() && monOeuvre(id) && !('rev' in nouveau()));
      allow update: if admin()
        || (soi(resource.data.aid) && comptePro() && monOeuvre(id) && inchange('aid') && inchange('num') && inchange('ts') && aucun(['rev']))
        || (peut('val') && seulement(['rev', 'revwhy', 'revts']));
      allow delete: if admin();
    }
    function monOeuvre(w) { return exists(chemin('works', w)) && get(chemin('works', w)).data.get('aid', '') == request.auth.uid; }
    // Visite guidée d'une œuvre (identifiant = identifiant de l'œuvre)
    match /tour/{id} {
      allow read: if true;
      allow write: if equipe() || (connecte() && exists(chemin('works', id))
        && get(chemin('works', id)).data.aid == request.auth.uid);
    }

    // -------------------------------------------------------------- expositions
    match /expo/{id} { allow read: if true; allow write: if equipe(); }
    match /eapp/{id} {
      allow read: if soi(resource.data.aid) || equipe() || resource.data.st == 'ok';
      allow create: if soi(nouveau().aid) && nouveau().st == 'att'
        && !nouveau().keys().hasAny(['paid', 'amt', 'dec']);
      allow update: if equipe()
        || (soi(resource.data.aid) && inchange('aid') && inchange('st') && seulement(['wids', 'note', 'up', 'ts']));
      allow delete: if soi(resource.data.aid) || equipe();
    }
    match /evis/{id} {
      allow read: if equipe();
      allow create: if soi(nouveau().u);
    }

    // ---------------------------------------------- appels audio/vidéo et lives
    match /calls/{id} {
      allow read: if soi(resource.data.from) || soi(resource.data.to);
      // Même règle que les messages : un visiteur n'appelle pas quelqu'un qui n'a pas accepté sa demande.
      allow create: if soi(nouveau().from) && nouveau().to is string && nouveau().to != nouveau().from
        && (membre() || discussionOuverte(nouveau().from, nouveau().to));
      allow update: if (soi(resource.data.from) || soi(resource.data.to)) && inchange('from') && inchange('to');
    }
    match /lives/{id} {
      allow read: if true;
      allow create, update: if soi(id) && membre() && nouveau().get('host', id) == id
        && nouveau().get('guests', []).size() <= 3;
      allow delete: if soi(id);
    }
    match /livej/{id} {
      allow read: if soi(resource.data.host) || soi(resource.data.viewer);
      allow create: if soi(nouveau().viewer);
      allow update, delete: if (soi(resource.data.host) || soi(resource.data.viewer))
        && inchange('host') && inchange('viewer');
    }
    match /livec/{id} {
      allow read: if true;
      allow create: if soi(nouveau().uid) && texteCourt('t', 500);
      allow delete: if soi(resource.data.uid) || peut('rep');
    }

    // ------------------------------------------ assistance, commandes, demandes
    match /tickets/{id} {
      allow read: if soi(resource.data.uid) || peut('tk');
      allow create: if soi(nouveau().uid) && nouveau().st == 'ouvert';
      allow update: if (soi(resource.data.uid) && inchange('uid') && inchange('pr')) || peut('tk');
    }
    match /orders/{id} {
      allow read: if soi(resource.data.buyer) || soi(resource.data.seller);
      allow create: if soi(nouveau().buyer);
      allow update: if (soi(resource.data.buyer) || soi(resource.data.seller))
        && inchange('buyer') && inchange('seller') && inchange('total')
        && inchange('items') && inchange('num') && inchange('ts');
    }
    match /resv/{id} {
      allow read: if soi(resource.data.uid) || soi(resource.data.aid);
      allow create: if (soi(nouveau().uid) || soi(nouveau().aid)) && nouveau().uid is string && nouveau().aid is string;
      allow delete: if soi(resource.data.uid) || soi(resource.data.aid);
    }
    match /reports/{id} {
      allow read: if soi(resource.data.by) || peut('rep');
      allow create: if soi(nouveau().by) && nouveau().st == 'att' && texteCourt('note', 500);
      allow update: if peut('rep');
      allow delete: if admin();
    }
    // Demandes Pro / certification / suppression : identifiant = type_membre
    match /proreq/{id} {
      allow read: if soi(resource.data.uid) || peut('req');
      // Jamais de donnée d'identité ici : le dossier privé est dans data/users/<membre>/
      allow create: if soi(nouveau().uid) && nouveau().st == 'att' && id == nouveau().k + '_' + nouveau().uid
        && !nouveau().keys().hasAny(['pn', 'n', 'img', 'atl', 'ref']);
      allow update: if peut('req')
        || (soi(resource.data.uid) && inchange('uid') && inchange('k') && nouveau().st in ['att', 'non']);
      allow delete: if soi(resource.data.uid) || peut('req');
    }

    // ------------------------------------------------ paiements et journal
    // Les paiements ne sont enregistrés que par l'administrateur (ou, plus tard,
    // par le serveur du prestataire de paiement, qui ne passe pas par ces règles).
    match /pay/{id} {
      allow read: if soi(resource.data.uid);
      allow write: if admin();
    }
    match /logs/{id} {
      allow read: if equipe();
      allow create: if equipe() && soi(nouveau().by);
    }

    // Tout le reste est refusé.
  }
}
